{
  "name": "tomlite",
  "version": "0.1.1",
  "description": "A minimal, robust, and safe TOML parser and serializer for JavaScript and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "toml",
    "parser",
    "serializer",
    "stringify",
    "typescript"
  ],
  "author": "kujirahand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kujirahand/tomlite-js.git"
  },
  "homepage": "https://github.com/kujirahand/tomlite-js#readme",
  "bugs": {
    "url": "https://github.com/kujirahand/tomlite-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
